// ===========================================
// City Population & Household Survey System
// Prisma Schema — Supabase PostgreSQL
// ===========================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  CITY_ADMIN
  RESIDENT
  PUBLIC
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  WIDOWED
  DIVORCED
  SEPARATED
}

enum EmploymentStatus {
  EMPLOYED
  SELF_EMPLOYED
  UNEMPLOYED
  RETIRED
  STUDENT
  HOMEMAKER
  OTHER
}

enum IncomeRange {
  PREFER_NOT_TO_DISCLOSE
  NO_INCOME
  BELOW_1_LAKH
  ONE_TO_THREE_LAKH
  THREE_TO_FIVE_LAKH
  FIVE_TO_TEN_LAKH
  TEN_TO_TWENTY_LAKH
  ABOVE_TWENTY_LAKH
}

enum SurveyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

// ─── User & Auth ─────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  password        String
  phone           String?
  role            UserRole  @default(PUBLIC)
  emailVerified   DateTime?
  image           String?
  isActive        Boolean   @default(true)

  householdId     String?
  household       Household? @relation(fields: [householdId], references: [id])

  notifications       Notification[]
  correctionRequests   CorrectionRequest[]
  auditLogs           AuditLog[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([email])
  @@index([role])
  @@index([householdId])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Geographic Hierarchy ────────────────────────────

model Ward {
  id          String   @id @default(uuid())
  wardNumber  Int      @unique
  name        String
  description String?  @db.Text

  areas       Area[]
  streets     Street[]
  households  Household[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([wardNumber])
  @@map("wards")
}

model Area {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text

  wardId      String?
  ward        Ward?    @relation(fields: [wardId], references: [id])

  streets     Street[]
  households  Household[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([wardId])
  @@map("areas")
}

model Street {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text

  wardId      String?
  ward        Ward?    @relation(fields: [wardId], references: [id])
  areaId      String?
  area        Area?    @relation(fields: [areaId], references: [id])

  buildings   Building[]
  households  Household[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([wardId])
  @@index([areaId])
  @@map("streets")
}

model Building {
  id          String   @id @default(uuid())
  name        String
  houseNumber String
  description String?  @db.Text

  streetId    String?
  street      Street?  @relation(fields: [streetId], references: [id])

  households  Household[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([streetId])
  @@index([houseNumber])
  @@map("buildings")
}

// ─── Household & Family ──────────────────────────────

model Household {
  id                 String       @id @default(uuid())
  surveyId           String       @unique
  houseNumber        String
  headOfFamily       String       @default("")
  address            String       @db.Text
  phone              String?
  email              String?

  wardId             String
  ward               Ward         @relation(fields: [wardId], references: [id])
  areaId             String?
  area               Area?        @relation(fields: [areaId], references: [id])
  streetId           String?
  street             Street?      @relation(fields: [streetId], references: [id])
  buildingId         String?
  building           Building?    @relation(fields: [buildingId], references: [id])

  totalMembers       Int          @default(0)
  totalLivingHere    Int          @default(0)
  totalLivingAbroad  Int          @default(0)

  surveyDate         DateTime?
  surveyStatus       SurveyStatus @default(PENDING)
  lastUpdated        DateTime     @updatedAt

  familyMembers      FamilyMember[]
  users              User[]
  correctionRequests CorrectionRequest[]

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  @@index([surveyId])
  @@index([wardId])
  @@index([areaId])
  @@index([streetId])
  @@index([buildingId])
  @@index([houseNumber])
  @@index([surveyStatus])
  @@map("households")
}

model FamilyMember {
  id                String           @id @default(uuid())

  householdId       String
  household         Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)

  fullName          String
  gender            Gender
  dateOfBirth       DateTime
  relationship      String           // e.g., Head, Spouse, Son, Daughter, etc.
  maritalStatus     MaritalStatus    @default(SINGLE)

  // Employment
  occupation        String?
  employmentStatus  EmploymentStatus @default(OTHER)
  workPlace         String?
  incomeRange       IncomeRange?     // NULL = not disclosed — NEVER mandatory

  // Education
  educationStatus   String?          // e.g., Illiterate, Primary, Secondary, Graduate, Post-Graduate
  isStudent         Boolean          @default(false)
  schoolCollegeName String?
  currentClass      String?

  // Living Status
  livingHere        Boolean          @default(true)
  livingAbroad      Boolean          @default(false)
  country           String?          // If living abroad

  // Contact (optional)
  phone             String?
  email             String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  @@index([householdId])
  @@index([fullName])
  @@index([gender])
  @@index([livingHere])
  @@index([livingAbroad])
  @@index([isStudent])
  @@index([employmentStatus])
  @@map("family_members")
}

// ─── Notifications ───────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)

  userId    String
  user      User             @relation(fields: [userId], references: [id])

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─── Correction Requests ─────────────────────────────

model CorrectionRequest {
  id          String           @id @default(uuid())
  description String          @db.Text
  status      CorrectionStatus @default(PENDING)
  response    String?          @db.Text

  userId      String
  user        User             @relation(fields: [userId], references: [id])
  householdId String
  household   Household        @relation(fields: [householdId], references: [id])

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([householdId])
  @@index([status])
  @@map("correction_requests")
}

// ─── Audit Log ───────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entity    String   // User, Household, FamilyMember, etc.
  entityId  String?
  details   String?  @db.Text // JSON string of changes
  ipAddress String?

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── System Settings ─────────────────────────────────

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ─── Reports ─────────────────────────────────────────

model Report {
  id        String   @id @default(uuid())
  name      String
  type      String   // POPULATION, STUDENTS, EMPLOYMENT, etc.
  format    String   // PDF, EXCEL, CSV
  filters   String?  @db.Text // JSON string of applied filters
  filePath  String?
  status    String   @default("PENDING") // PENDING, GENERATING, COMPLETED, FAILED

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([createdBy])
  @@map("reports")
}
